{
  "name": "homebridge-sony-projector-control",
  "displayName": "Sony Projector Control",
  "version": "0.2.1-test",
  "description": "索尼投影仪控制：电源、画面调节、预热／就绪／冷却传感器，支持中英文设置。Sony ADCP/SDCP projector control.",
  "author": "roninriddle",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "homebridge": "^1.8.0 || ^2.0.0",
    "node": "^22.20.0 || ^24.0.0 || ^26.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homebridge",
    "homekit",
    "sony",
    "projector",
    "vpl",
    "adcp",
    "sdcp",
    "pj-talk",
    "television",
    "apple-tv-remote",
    "supports-matter"
  ],
  "scripts": {
    "clean": "node -e \"for(const p of ['dist','homebridge-ui/public/lib'])require('node:fs').rmSync(p,{force:true,recursive:true})\"",
    "prebuild": "npm run clean && npm run build-ui",
    "build": "tsc -p tsconfig.build.json",
    "build-ui": "homebridge-plugin-utils prepare-ui homebridge-ui/public/lib",
    "build-docs": "npm run build && homebridge-plugin-utils prepare-docs dist/options.js",
    "check-docs": "homebridge-plugin-utils prepare-docs dist/options.js --check",
    "lint": "eslint --max-warnings=0 eslint.config.mjs src homebridge-ui/server.js homebridge-ui/public/*.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=20000 \"src/**/*.test.ts\" \"homebridge-ui/test/*.test.mjs\"",
    "test:coverage": "node --test --experimental-test-coverage --test-timeout=20000 \"src/**/*.test.ts\" \"homebridge-ui/test/*.test.mjs\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "dev": "npm run build && homebridge -I -D -U ./test/hbConfig -P ..",
    "fake-projector": "node src/fake-projector.helpers.ts"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "homebridge-plugin-utils": "2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "22.20.4",
    "eslint": "9.39.2",
    "happy-dom": "21.0.3",
    "homebridge": "2.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "homebridge-ui/server.js",
    "homebridge-ui/public",
    "config.schema.json",
    "docs/*.md",
    "CHANGELOG.md",
    "CREDITS.md",
    "LICENSE",
    "README.md",
    "NOTICE.md",
    "examples/*.json",
    "scripts/migrate-config.mjs",
    "README.zh-CN.md",
    "scripts/install-homebridge-ui-icon.mjs"
  ],
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roninriddle/homebridge-sony-projector-control.git"
  },
  "homepage": "https://github.com/roninriddle/homebridge-sony-projector-control#readme",
  "bugs": {
    "url": "https://github.com/roninriddle/homebridge-sony-projector-control/issues"
  }
}
