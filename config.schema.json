{
  "pluginAlias": "SonyProjectorUnified",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "headerDisplay": "Sony Projector Control",
  "footerDisplay": "Run this plugin as a [child bridge](https://github.com/homebridge/homebridge/wiki/Child-Bridges). Each projector appears as its own TV accessory: add it in the Home app with **Add Accessory > More options** and your Homebridge setup code.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform name",
        "type": "string",
        "default": "Sony Projector Control"
      },
      "projectors": {
        "title": "Projectors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name / \u540d\u79f0",
              "type": "string",
              "placeholder": "Projector",
              "description": "How the projector is named in HomeKit."
            },
            "host": {
              "title": "IP address or hostname / \u5730\u5740",
              "type": "string",
              "placeholder": "192.168.1.50",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9.:-]{0,251}[A-Za-z0-9])?$",
              "description": "Give the projector a fixed address (a DHCP reservation) so it does not change."
            },
            "protocol": {
              "title": "Control protocol / \u63a7\u5236\u534f\u8bae",
              "type": "string",
              "default": "auto",
              "oneOf": [
                {
                  "title": "Automatic (recommended)",
                  "enum": [
                    "auto"
                  ]
                },
                {
                  "title": "ADCP: VPL-VW 2016 and later, VPL-XW",
                  "enum": [
                    "adcp"
                  ]
                },
                {
                  "title": "SDCP / PJ Talk: older VPL-VW and VPL-HW",
                  "enum": [
                    "sdcp"
                  ]
                }
              ]
            },
            "password": {
              "title": "Administrator password / \u7ba1\u7406\u5458\u5bc6\u7801",
              "type": "string",
              "x-schema-form": {
                "type": "password"
              },
              "description": "\u9ed8\u8ba4 Projector\uff0c\u53ef\u624b\u52a8\u4fee\u6539\u4e3a\u6295\u5f71\u4eea\u5f53\u524d\u7ba1\u7406\u5458\u5bc6\u7801\u3002\u7559\u7a7a\u8868\u793a\u4e0d\u63d0\u4f9b\u5bc6\u7801\uff1b\u65e0\u8ba4\u8bc1\u6a21\u5f0f\u4f1a\u81ea\u52a8\u8bc6\u522b\u3002 \u5982\u9700\u514d\u5bc6\u7801\u63a7\u5236\uff0c\u8bf7\u5728\u6295\u5f71\u4eea\u7f51\u9875 ADCP \u8bbe\u7f6e\u4e2d\u5173\u95ed Requires Authentication\uff1b\u4fdd\u6301\u5f00\u542f\u5219\u586b\u5199\u7ba1\u7406\u5458\u5bc6\u7801\u3002\u63d2\u4ef6\u81ea\u52a8\u8bc6\u522b\u8ba4\u8bc1\u72b6\u6001\u3002",
              "default": "Projector"
            },
            "community": {
              "title": "SDCP community",
              "type": "string",
              "placeholder": "SONY",
              "minLength": 4,
              "maxLength": 4,
              "description": "Only for SDCP projectors whose PJ Talk community was changed from SONY."
            },
            "port": {
              "title": "Port / \u7aef\u53e3",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "description": "Only needed for a non-standard port. Requires an explicit protocol (ADCP default 53595, SDCP default 53484).",
              "x-schema-form": {
                "type": "number"
              }
            },
            "pollInterval": {
              "title": "Poll interval / \u72b6\u6001\u540c\u6b65\u95f4\u9694\uff08\u79d2\uff09",
              "type": "integer",
              "minimum": 3,
              "maximum": 300,
              "placeholder": 10,
              "description": "How often to check the projector while it is on. Standby is checked three times less often."
            },
            "id": {
              "title": "Stable device ID / \u56fa\u5b9a\u8bbe\u5907\u6807\u8bc6",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
              "description": "Set once (for example theater-hw69); keep it unchanged when changing the IP address."
            },
            "autoPowerOn": {
              "title": "Auto power on and wait / \u81ea\u52a8\u5f00\u673a\u5e76\u7b49\u5f85\u5c31\u7eea",
              "type": "boolean",
              "default": false,
              "description": "Optional. Input, picture and remote controls may wait up to the readiness timeout. Disabled by default."
            },
            "readyTimeout": {
              "title": "Readiness timeout / \u5c31\u7eea\u7b49\u5f85\u4e0a\u9650\uff08\u79d2\uff09",
              "type": "integer",
              "minimum": 10,
              "maximum": 300,
              "default": 120
            },
            "inputSource": {
              "title": "TV input picker / \u7535\u89c6\u8f93\u5165\u5217\u8868",
              "type": "string",
              "default": "hdmi",
              "oneOf": [
                {
                  "title": "HDMI sources / HDMI \u8f93\u5165",
                  "enum": [
                    "hdmi"
                  ]
                },
                {
                  "title": "Picture modes / \u753b\u9762\u6a21\u5f0f",
                  "enum": [
                    "pictureModes"
                  ]
                }
              ]
            },
            "capabilities": {
              "title": "Capability overrides / \u80fd\u529b\u8986\u76d6",
              "type": "object",
              "properties": {
                "inputs": {
                  "title": "Inputs / \u8f93\u5165",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "description": "Optional override of detected tokens; values must match your projector. Leave unset for discovery."
                },
                "pictureModes": {
                  "title": "Picture modes / \u753b\u9762\u6a21\u5f0f",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "description": "Optional override of detected tokens; values must match your projector. Leave unset for discovery."
                },
                "aspects": {
                  "title": "Aspect ratios / \u753b\u5e45",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "description": "Optional override of detected tokens; values must match your projector. Leave unset for discovery."
                },
                "hdrModes": {
                  "title": "HDR modes / HDR \u6a21\u5f0f",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "description": "Optional override of detected tokens; values must match your projector. Leave unset for discovery."
                },
                "testPatterns": {
                  "title": "Test patterns / \u6d4b\u8bd5\u56fe",
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.]+$"
                  },
                  "description": "Optional override of detected tokens; values must match your projector. Leave unset for discovery."
                },
                "brightness": {
                  "title": "brightness",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                },
                "contrast": {
                  "title": "contrast",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                },
                "blank": {
                  "title": "blank",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                },
                "faults": {
                  "title": "faults",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                },
                "lightHours": {
                  "title": "lightHours",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                },
                "remote": {
                  "title": "remote",
                  "type": "boolean",
                  "description": "Optional support override; leave unset for discovery."
                }
              }
            },
            "username": {
              "title": "Administrator username / \u7ba1\u7406\u5458\u7528\u6237\u540d",
              "type": "string",
              "default": "root",
              "description": "Web administrator account. ADCP authenticates with the password only."
            },
            "language": {
              "title": "Accessory names / \u914d\u4ef6\u540d\u79f0\u8bed\u8a00",
              "type": "string",
              "default": "en",
              "oneOf": [
                {
                  "title": "English",
                  "enum": [
                    "en"
                  ]
                },
                {
                  "title": "\u7b80\u4f53\u4e2d\u6587",
                  "enum": [
                    "zh-CN"
                  ]
                }
              ],
              "description": "Each optional control and sensor is published as a separately named accessory."
            }
          }
        }
      },
      "options": {
        "title": "Feature options",
        "type": "array",
        "items": {
          "type": "string",
          "title": "Feature option"
        },
        "description": "Use the Feature Options tab in this plugin's settings instead of editing these by hand."
      },
      "debug": {
        "title": "Debug logging",
        "type": "boolean",
        "default": false,
        "description": "Log protocol traffic for troubleshooting. Passwords are never logged."
      },
      "uiLanguage": {
        "title": "Interface language / \u754c\u9762\u8bed\u8a00",
        "type": "string",
        "default": "en",
        "oneOf": [
          {
            "title": "English",
            "enum": [
              "en"
            ]
          },
          {
            "title": "\u7b80\u4f53\u4e2d\u6587",
            "enum": [
              "zh-CN"
            ]
          }
        ]
      }
    }
  },
  "layout": [
    {
      "key": "projectors",
      "type": "array",
      "orderable": false,
      "buttonText": "Add projector",
      "items": [
        "projectors[].name",
        "projectors[].language",
        "projectors[].host",
        "projectors[].username",
        "projectors[].password",
        {
          "type": "section",
          "title": "Advanced",
          "expandable": true,
          "expanded": false,
          "items": [
            "projectors[].protocol",
            "projectors[].port",
            "projectors[].community",
            "projectors[].pollInterval",
            "projectors[].id",
            "projectors[].inputSource",
            "projectors[].autoPowerOn",
            "projectors[].readyTimeout",
            "projectors[].capabilities"
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "Additional settings",
      "expandable": true,
      "expanded": false,
      "items": [
        "name",
        "debug",
        "options"
      ]
    }
  ]
}
